generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String
  senha    String
  perfil   Perfil   @default(PARTICIPANTE)
  criadoEm DateTime @default(now())

  certificados Certificado[]
  matriculas   Matricula[]

  @@unique([email])
  @@map("usuarios")
}

model Curso {
  id        Int    @id @default(autoincrement())
  titulo    String
  descricao String

  status   Status   @default(ATIVO)
  criadoEm DateTime @default(now())

  modulos              Modulo[]
  matriculas           Matricula[]
  certificadoModelo    CertificadoModelo?   @relation(fields: [certificadoModeloId], references: [id])
  certificadoModeloId  Int?
  videos               Video[]
  matriculasProgressos MatriculaProgresso[]
  certificados         Certificado[]

  @@map("cursos")
}

model Modulo {
  id        Int    @id @default(autoincrement())
  cursoId   Int
  titulo    String
  descricao String
  ordem     Int

  cursos Curso   @relation(fields: [cursoId], references: [id])
  videos Video[]

  @@map("modulos")
}

model Video {
  id              Int    @id @default(autoincrement())
  moduloId        Int
  cursoId         Int
  titulo          String
  key             String
  duracaoSegundos Int
  ordem           Int

  cursos  Curso  @relation(fields: [cursoId], references: [id])
  modulos Modulo @relation(fields: [moduloId], references: [id])

  certificadoModelo   CertificadoModelo?   @relation(fields: [certificadoModeloId], references: [id])
  certificadoModeloId Int?
  matriculaProgressos MatriculaProgresso[]

  @@map("videos")
}

model Matricula {
  id        Int             @id @default(autoincrement())
  cursoId   Int
  usuarioId Int
  status    MatriculaStatus @default(CONFIRMADA)
  concluido Boolean         @default(false)
  criadoEm  DateTime        @default(now())

  cursos   Curso   @relation(fields: [cursoId], references: [id])
  usuarios Usuario @relation(fields: [usuarioId], references: [id])

  @@map("matriculas")
}

model MatriculaProgresso {
  id                 Int      @id @default(autoincrement())
  matriculaId        Int
  usuarioId          Int
  videoId            Int
  segundosAssistidos Int
  concluido          Boolean  @default(false)
  criadoEm           DateTime @default(now())

  videos  Video  @relation(fields: [videoId], references: [id])
  curso   Curso? @relation(fields: [cursoId], references: [id])
  cursoId Int?

  @@map("matriculas_progresso")
}

model CertificadoModelo {
  id       Int             @id @default(autoincrement())
  titulo   String
  lado     CertificadoLado
  key      String
  criadoEm DateTime        @default(now())

  videos       Video[]
  cursos       Curso[]
  certificados Certificado[]

  @@map("certificados_modelo")
}

model Certificado {
  id                  Int      @id @default(autoincrement())
  cursoId             Int
  usuarioId           Int
  modeloCertificadoId Int
  cargaHorariaMinutos Int
  numeroCertificado   String   @unique
  criadoEm            DateTime @default(now())

  usuarios Usuario           @relation(fields: [usuarioId], references: [id])
  cursos   Curso             @relation(fields: [cursoId], references: [id])
  modelos  CertificadoModelo @relation(fields: [modeloCertificadoId], references: [id])

  @@map("certificados")
}

enum Status {
  ATIVO
  INATIVO
}

enum Perfil {
  ADMIN
  PARTICIPANTE
  INSTRUTOR
}

enum MatriculaStatus {
  CONFIRMADA
  CANCELADA
}

enum CertificadoLado {
  FRENTE
  VERSO
}
